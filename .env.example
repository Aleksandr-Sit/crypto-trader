# ============================================================
# ШАБЛОН КОНФИГУРАЦИИ — скопируй в .env и заполни значения
# Файл .env НИКОГДА не коммитится в git
# На VPS: chmod 600 .env
# ============================================================

# ------------------------------------------------------------
# BYBIT (основная биржа)
# Создать на: Bybit → Account → API Management
# Права: Read + Trade (БЕЗ Withdraw!)
# IP Restriction: указать IP твоего VPS (обязательно!)
# ------------------------------------------------------------
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=false

# ------------------------------------------------------------
# MEXC (запасная биржа)
# Создать на: MEXC → Profile → API Management
# Права: Read + Trade (БЕЗ Withdraw!)
# ------------------------------------------------------------
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_api_secret_here

# ------------------------------------------------------------
# OKX (третья биржа)
# Создать на: OKX → Profile → API
# Права: Read + Trade (БЕЗ Withdraw!)
# Passphrase задаётся при создании ключа
# ------------------------------------------------------------
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# ------------------------------------------------------------
# TELEGRAM BOT
# 1. Открой @BotFather в Telegram
# 2. /newbot → получи TELEGRAM_BOT_TOKEN
# 3. Открой @userinfobot → получи свой TELEGRAM_CHAT_ID
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_personal_chat_id_here

# ------------------------------------------------------------
# АДРЕСА ВЫВОДА (холодный кошелёк)
# ТОЛЬКО на твой личный кошелёк — Ledger/Trezor
# Проверь адрес 3 раза перед вставкой!
# ------------------------------------------------------------
WITHDRAWAL_ADDRESS_USDT_TRC20=your_trc20_wallet_address
WITHDRAWAL_ADDRESS_USDT_ERC20=your_erc20_wallet_address
WITHDRAWAL_ADDRESS_BTC=your_btc_wallet_address

# ------------------------------------------------------------
# NEWS SENTINEL
# CryptoPanic: https://cryptopanic.com/developers/api/
# Бесплатный план: 1000 запросов/день — достаточно
# ------------------------------------------------------------
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# ------------------------------------------------------------
# ИНФРАСТРУКТУРА
# Redis: для хранения состояния между рестартами
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# РЕЖИМ РАБОТЫ
# paper = симуляция без реальных денег (для тестов)
# live  = реальная торговля
# ------------------------------------------------------------
TRADING_MODE=paper
